# Copie para .env e ajuste. O .env não vai para o git.

# Banco PostgreSQL usado pela API e pelas migrações do Alembic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/casalorenzi

# Chave para assinar os tokens de login (use um valor longo e aleatório fora do ambiente local)
JWT_SECRET=dev-somente-local-troque-esta-chave-em-producao
JWT_EXPIRA_HORAS=2

# Endereços do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuso usado nos filtros de data e no agrupamento do financeiro
FUSO_HORARIO=America/Sao_Paulo

# Banco separado para rodar os testes (pytest). Sem ele, os testes são pulados.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/casalorenzi_test

# Nível dos logs: DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO

# E-mails pelo Resend (https://resend.com). Sem a chave, o conteúdo dos e-mails vai para o log da API.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. onboarding@resend.dev só entrega para o seu próprio e-mail.
EMAIL_REMETENTE=Casa Lorenzi <onboarding@resend.dev>
# Endereço do site, para os links dos e-mails
URL_FRONTEND=http://localhost:5173

# "Esqueci a senha": true devolve o link de troca na resposta da API (só para demonstração;
# nunca em produção). Com false, o link aparece apenas no log da API.
LINK_SENHA_NA_RESPOSTA=false

# Endereço público da API para os links das fotos de produto (ex.: https://api.casalorenzi.com.br).
# Vazio: usa o endereço pelo qual a requisição chegou.
URL_PUBLICA_API=

# ---------- Assistentes de IA (docs/assistente_ia.md) ----------
# Chave da API da Anthropic (Claude). Vazio: os assistentes respondem só pelas regras (sem LLM).
# Nunca coloque a chave no git nem no frontend.
ANTHROPIC_API_KEY=
# Modelo: claude-haiku-5-5 (padrão, econômico), claude-sonnet-5-5 ou claude-opus-5-5
IA_MODELO=claude-haiku-5-5
# Quanto o modelo raciocina: low (padrão), medium ou high
IA_ESFORCO=low
IA_MAX_TOKENS=2048
IA_TIMEOUT_SEGUNDOS=25
IA_MAX_TENTATIVAS=1
# Mensagens anteriores enviadas ao modelo e limites por mensagem
IA_HISTORICO_MENSAGENS=12
IA_MAX_RODADAS=4
IA_MAX_FERRAMENTAS=6
# Conversa parada recomeça depois de N horas; conversas são apagadas N dias depois da última atividade
IA_CONVERSA_EXPIRA_HORAS=24
IA_RETENCAO_DIAS=90
# Saudação, agradecimento e pedido de atendente sem chamar o modelo
IA_RESPOSTAS_DIRETAS=true

# Banco só de leitura para o copiloto e as automações (opcional: usuário do Postgres só com SELECT).
# Vazio: usa DATABASE_URL, em transações READ ONLY com tempo máximo por consulta.
DATABASE_URL_LEITURA=
CONSULTA_TIMEOUT_MS=8000

# Automações (python -m src.automacoes)
ALERTA_ESTOQUE_BAIXO_JANELA_DIAS=60
ALERTA_ESTOQUE_PARADO_DIAS=90
ALERTA_PONTOS_DIAS=30
