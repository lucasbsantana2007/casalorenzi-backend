# Copie para .env e ajuste. O .env não vai para o git.

# Banco PostgreSQL usado pela API e pelas migrações do Alembic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/casalorenzi

# Chave para assinar os tokens de login (use um valor longo e aleatório fora do ambiente local)
JWT_SECRET=dev-somente-local-troque-esta-chave-em-producao
JWT_EXPIRA_HORAS=12

# Endereços do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuso usado nos filtros de data e no agrupamento do financeiro
FUSO_HORARIO=America/Sao_Paulo

# Opcional: banco separado para rodar os testes (pytest)
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/casalorenzi_test

# "Esqueci o PIN": true devolve o link de troca na resposta da API (só para demonstração;
# nunca em produção). Com false, o link aparece apenas no log da API.
PIN_LINK_NA_RESPOSTA=false
